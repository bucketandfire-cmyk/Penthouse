# Discord login only (Developer Portal > your app > OAuth2). There is no bot.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN/callback
# Your server ID. Only needed if you use REQUIRE_MEMBER=1 or ACCESS_ROLE_IDS.
DISCORD_GUILD_ID=

# Web server
DISCORD_INVITE_URL=       # your server invite, e.g. https://discord.gg/yourcode (shown on the front page)
# Social links shown on the front page and clipping page
TIKTOK_URL=https://www.tiktok.com/@yourhandle
X_URL=https://x.com/yourhandle
INSTAGRAM_URL=https://www.instagram.com/yourhandle
# Where the front page's Contact section sends people (work with us / work for us). Falls back to your Discord invite.
CONTACT_EMAIL=contact@yourdomain.com
# Discord webhook URL of a private staff channel: new Contact form messages are posted there automatically
# (Channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL)
CONTACT_WEBHOOK_URL=
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000

# Wallet tracking (helius.dev)
HELIUS_API_KEY=
DAYS_BACK=30
MAX_PAGES=6
CONCURRENCY=4

# Discovery + rotation (all optional, defaults shown)
AUTO_CYCLE=0              # 1 = run discover > ingest > rotate on a timer inside npm start
CYCLE_HOURS=24
MIN_PEAK_FDV_USD=1000000  # what counts as a winning token
MIN_GAIN_X=3
MIN_LIQ_USD=10000
TOKENS_PER_RUN=25
TRADERS_PER_TOKEN=15
MIN_TRADES_30=20
MIN_TRADES_7=5
CONFIRM_REVIEWS=2         # passing reviews in a row before a wallet is (re)promoted
ROSTER_WEBHOOK_URL=       # Discord channel webhook for promotion/bench announcements
DEX_MATCH=meteora|launchlab|stonk|pump   # which Solana DEX/launchpad feeds discovery scans

# Meta (narrative) detection
META_MIN_TOKENS=4         # launches in a week before a theme counts
META_MIN_VOL_USD=20000    # a token must have traded at least this much in one day to count as 'real attention'
META_WEBHOOK_URL=         # Discord webhook that announces new emerging/hot metas

# Paywall (crypto, Solana). The server only WATCHES this address; it never holds keys.
TREASURY_WALLET=          # your Solana wallet address that receives payments
PRICE_USD=49
PERIOD_DAYS=30
INVOICE_MINUTES=30        # how long a quoted SOL price is held
PAYWALL_ENABLED=1         # 0 = open to any signed-in user (testing only)
ADMIN_DISCORD_IDS=        # comma-separated Discord user IDs with free access (you)
ACCESS_ROLE_IDS=          # comma-separated Discord role IDs with free access (staff, lifetime members)
REQUIRE_MEMBER=0          # 1 = buyers must also be in your Discord server

# My wallets: how many wallets each member can track, and the total of non-roster wallets across all members
USER_WALLET_LIMIT=25
USER_WALLET_GLOBAL_CAP=500

# Live pings (small notifications on the dashboard). Needs a public https site.
# 1) set these, 2) run: npm run webhook (the cycle also does this each time the roster changes)
PUBLIC_URL=https://yourdomain.com
HELIUS_WEBHOOK_SECRET=make-up-a-long-random-string
PING_MIN_SOL=1

# Growth settings
QUARTER_DISCOUNT_PCT=10   # 3 months at this % off. 0 hides the quarterly plan
REFERRAL_DAYS=7           # free days a member earns per paying referral. 0 turns referrals off
REFUND_DAYS=0             # 0 = payments are final. Set e.g. 7 only if you will honor refunds (shown in the FAQ and pricing)
PREVIEW_DELAY_HOURS=24    # how old the free Metas / top-wallets preview on the landing page is
RECAP_WEBHOOK_URL=        # webhook of a PUBLIC Discord channel for npm run daily / npm run weekly (run them from cron)
CLIP_RATE=               # e.g. $1 per 1,000 approved views (shown on /clipping)
CLIP_MIN=                # e.g. $20 minimum payout
CLIP_PAYDAY=             # e.g. Every Friday
TOP_CLIPPER=             # e.g. Clipper of the month: @name with 1.2M views
